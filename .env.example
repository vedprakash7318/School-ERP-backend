# ==============================================================================
# BACKEND SERVER CONFIGURATION (EXAMPLE TEMPLATE)
# Copy this file to .env and adjust the values for your environment.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Direct Mongoose Driver)
# Local: mongodb://127.0.0.1:27017/school_erp
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/school_erp?retryWrites=true&w=majority
MONGODB_URI="mongodb://127.0.0.1:27017/school_erp"

# JWT Authentication Secret & Token Expiration
JWT_SECRET="your_strong_jwt_secret_key_change_in_production"
JWT_EXPIRES_IN="7d"

# Frontend Origin URLs (CORS & Redirections)
SUPER_ADMIN_FRONTEND_URL="http://localhost:5173"
SCHOOL_ADMIN_FRONTEND_URL="http://localhost:5174"

# Public Access Base URL
PUBLIC_URL="http://localhost:5000"

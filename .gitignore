# ==============================================================================
# BACKEND .gitignore
# ==============================================================================

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files & Secrets
.env
.env.local
.env.*.local
!.env.example

# File uploads (Preserve directory structure with .gitkeep)
uploads/*
!uploads/.gitkeep
!uploads/logos/.gitkeep
!uploads/students/.gitkeep
!uploads/staff/.gitkeep
!uploads/documents/.gitkeep

# SQLite / Database Files
*.db
*.db-journal
*.sqlite
*.sqlite3
dev.db*

# Logs
logs/
*.log

# OS & Editor
.DS_Store
Thumbs.db
.vscode/
.idea/
